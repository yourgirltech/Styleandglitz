# Copy these from your own Supabase project's Settings → API — do not commit
# real values here. The anon key is safe to expose in a deployed app (it's
# protected by Row Level Security, not secrecy), but a template file
# shouldn't ship a live project's real credentials either.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Instagram Graph API (Shop Our Instagram feed)
VITE_IG_USER_ID=
VITE_IG_ACCESS_TOKEN=

# Stripe (future payments)
VITE_STRIPE_PUBLISHABLE_KEY=

# n8n AI chatbot — only set this once the "Style & Glitz AI Chatbot" workflow
# is activated. Copy the exact production URL from the Chat Trigger node in
# n8n; do not construct it manually.
VITE_N8N_CHAT_WEBHOOK_URL=
